{
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0,
  "tasks": {
    "lint": "deno lint",
    "test": "deno test --allow-env"
  },
  "lint": {
    "include": ["packages", "infra", "scripts/clickup-sync"],
    "exclude": ["**/node_modules"]
  },
  "fmt": {
    "include": ["packages", "docs/adr"],
    "exclude": ["**/node_modules"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@enrailar/shared": "./packages/shared/src/index.ts",
    "zod": "npm:zod@4.6.7",
    "effect": "npm:effect@4.0.5",
    "effect/": "npm:/effect@4.0.5/",
    "playwright-core": "npm:playwright-core@1.64.1",
    "better-auth": "npm:better-auth@1.7.10",
    "better-auth/": "npm:/better-auth@1.7.10/",
    "@better-auth/passkey": "npm:@better-auth/passkey@1.7.10",
    "cloudflare:node": "./apps/api/src/shims/cloudflare-node.ts",
    "cloudflare:workers": "./apps/api/src/shims/cloudflare-workers.ts"
  }
}
